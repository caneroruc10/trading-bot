# Railway'de bu değerleri "Variables" sekmesine gir
# .env dosyasını asla GitHub'a yükleme!

# ── ZORUNLU
BINANCE_API_KEY=xxx
BINANCE_API_SECRET=xxx
TELEGRAM_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx

# ── İSTEĞE BAĞLI (varsayılanlar iyi)
SEMBOL=ETHUSDT
TIMEFRAME=1h
POZISYON_USDT=100
TEST_MODU=true

# Strateji parametreleri
ATR_PERIOD=18
EMA_PERIOD=4
COEFFICIENT=1.0
SCORE_THRESH=40
HARD_STOP_ATR=5.0
TRAIL_STOP_ATR=1.5
KAR_AL_ATR=5.5
